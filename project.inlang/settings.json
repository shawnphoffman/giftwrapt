{
	"$schema": "https://inlang.com/schema/project-settings",
	"baseLocale": "en",
	"locales": ["en", "fr"],
	"modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
	"plugin.inlang.messageFormat": {
		"pathPattern": [
			"./messages/{locale}/common.json",
			"./messages/{locale}/shell.json",
			"./messages/{locale}/settings.json",
			"./messages/{locale}/auth.json",
			"./messages/{locale}/items.json",
			"./messages/{locale}/lists.json",
			"./messages/{locale}/purchases.json",
			"./messages/{locale}/intelligence.json",
			"./messages/{locale}/misc.json",
			"./messages/{locale}/emails.json",
			"./messages/{locale}/server.json",
			"./messages/{locale}/admin-intelligence.json",
			"./messages/{locale}/admin-settings.json",
			"./messages/{locale}/admin-ai.json",
			"./messages/{locale}/admin-users.json"
		]
	}
}
