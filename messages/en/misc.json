{
	"$schema": "https://inlang.com/schema/inlang-message-format",
	"recent_comments_intro": "Items with comment activity, ordered by the most recent reply.",
	"recent_comments_empty": "No recent comments in this timeframe.",
	"recent_items_intro": "New items added to lists you can see, newest first.",
	"recent_items_empty": "No recent items in this timeframe.",
	"recent_view_item_in_list": "View item in list",
	"recent_comment_count": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} comment",
				"countPlural=*": "{count} comments"
			}
		}
	],
	"recent_earlier_comments": [
		{
			"declarations": ["input count", "local countPlural = count: plural"],
			"selectors": ["countPlural"],
			"match": {
				"countPlural=one": "{count} earlier comment",
				"countPlural=*": "{count} earlier comments"
			}
		}
	],
